#!/usr/bin/env bash
PROBE_OUTPUT=$(podman run \
  --rm \
  -i \
  --add-host=host.docker.internal:host-gateway \
  alpine sh -c "apk add --no-cache netcat-openbsd >/dev/null 2>&1; nc -w 3 host.docker.internal 5900" | tail -n 1 | tr -d '\r')

[ "$PROBE_OUTPUT" = "RFB 003.008" ] || { echo "Assertion failed: got '$PROBE_OUTPUT'"; exit 1; }
